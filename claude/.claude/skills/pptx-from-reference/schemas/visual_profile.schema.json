{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VisualProfile",
  "type": "object",
  "required": ["source_file", "theme", "layouts", "slide_size_in"],
  "properties": {
    "source_file": {"type": "string"},
    "theme": {
      "type": "object",
      "required": ["color_scheme", "font_scheme", "default_size_pt"],
      "properties": {
        "color_scheme": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"}
        },
        "font_scheme": {
          "type": "object",
          "properties": {
            "major_latin": {"type": "string"},
            "minor_latin": {"type": "string"},
            "major_ea": {"type": "string"},
            "minor_ea": {"type": "string"}
          }
        },
        "default_size_pt": {
          "type": "object",
          "properties": {
            "title": {"type": "number"},
            "body": {"type": "number"}
          }
        }
      }
    },
    "layouts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "placeholders"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "placeholders": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["idx", "type", "bbox_in"],
              "properties": {
                "idx": {"type": "integer"},
                "type": {"type": "string"},
                "bbox_in": {
                  "type": "object",
                  "required": ["x", "y", "w", "h"],
                  "properties": {
                    "x": {"type": "number"},
                    "y": {"type": "number"},
                    "w": {"type": "number"},
                    "h": {"type": "number"}
                  }
                }
              }
            }
          },
          "decorative_shapes_count": {"type": "integer", "default": 0}
        }
      }
    },
    "slide_size_in": {
      "type": "object",
      "required": ["w", "h"],
      "properties": {
        "w": {"type": "number"},
        "h": {"type": "number"}
      }
    }
  }
}
